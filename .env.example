# FORGE configuration. Copy to .env and fill in. Never commit real keys or RPC credentials.
# All development and demos run on a Surfpool mainnet fork; no mainnet funds are ever used.

# --- Fork (local development) ---
# Optional private mainnet RPC used read-only as the fork datasource (default: public mainnet).
FORK_RPC_URL=
FORK_RPC_PORT=8899
FORK_WS_PORT=8900

# --- Keys (paths outside the repository) ---
# Program upgrade authority (deployment key) and market-registry admin are separate keys.
FORGE_DEPLOYER_KEYPAIR=~/.config/solana/forge-deployer.json
FORGE_ADMIN_KEYPAIR=~/.config/solana/forge-admin.json
# Fork-only scenario reference signer (trusted demo assumption, labelled in the UI).
FORGE_REFERENCE_KEYPAIR=~/.config/solana/forge-reference.json
FORGE_KEEPER_KEYPAIR=~/.config/solana/forge-keeper.json
FORGE_LP_KEYPAIR=~/.config/solana/forge-lp.json

# --- Program ---
FORGE_PROGRAM_ID=8RQGTBgTpbvxZ9BFHpFthHRw5JkaHiUpfrMmjfUv3NN5

# --- Frontend (public, browser-visible) ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.example.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://rpc.example.com
NEXT_PUBLIC_FORGE_PROGRAM_ID=8RQGTBgTpbvxZ9BFHpFthHRw5JkaHiUpfrMmjfUv3NN5
NEXT_PUBLIC_EXPECTED_GENESIS_HASH=

# --- Hosted services (server-only) ---
FORGE_API_URL=https://api.example.com
ANTHROPIC_API_KEY=
FORGE_AGENT_MODEL=claude-opus-5-5
DEMO_CONTROL_TOKEN=
